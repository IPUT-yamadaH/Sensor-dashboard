# Database: Supabase/PostgreSQL (DB_TYPE=supabase) or Azure SQL (DB_TYPE=azure)
DB_TYPE=supabase
SUPABASE_HOST=
SUPABASE_PORT=5432
SUPABASE_DATABASE=postgres
SUPABASE_USER=postgres
SUPABASE_PASSWORD=
AZURE_SQL_SERVER=
AZURE_SQL_DATABASE=
AZURE_SQL_USERNAME=
AZURE_SQL_PASSWORD=
AZURE_SQL_DRIVER={ODBC Driver 18 for SQL Server}

# Create long random values before deployment; do not commit real values.
FLASK_SECRET_KEY=
ADMIN_PASSWORD=
USE_HTTPS=false

# Optional Ambient integration
AMB_CHANNEL_ID=0
AMB_WRITE_KEY=

SENSOR_HOST=0.0.0.0
SOCKET_PORT=8765
